# ============================================
# 环境变量配置模板 - Enterprise
# 复制此文件为 .env 并填入实际值
# ============================================

# ========== LLM 配置 ==========
LLM_API_KEY=your_api_key_here
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.7
LLM_FALLBACK_PROVIDER=anthropic
LLM_FALLBACK_MODEL=claude-sonnet-4-20250514

# ========== Agent 配置 ==========
AGENT_MAX_TURNS=100
AGENT_NAME=default
AGENT_CONCURRENCY=10

# ========== Redis 配置 (分布式会话) ==========
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# ========== 数据库配置 ==========
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/agentdb

# ========== 可观测性配置 ==========
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
PROMETHEUS_PORT=9090
LOG_LEVEL=INFO
LOG_FORMAT=json

# ========== 安全配置 ==========
JWT_SECRET=your_jwt_secret_here
API_KEY_SALT=your_salt_here

# ========== 部署配置 ==========
DEPLOY_ENV=development
DOCKER_REGISTRY=your-registry.example.com