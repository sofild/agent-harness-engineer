# ============================================
# 环境变量配置模板 - Professional
# 复制此文件为 .env 并填入实际值
# ============================================

# ========== LLM 配置 ==========
LLM_API_KEY=your_api_key_here
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.7

# ========== Agent 配置 ==========
AGENT_MAX_TURNS=50
AGENT_NAME=default

# ========== 工具配置 ==========
TOOLS_ALLOWED_DIR=./workspace
TOOLS_MAX_FILE_SIZE=10485760
TOOLS_NETWORK_ENABLED=true
TOOLS_BROWSER_ENABLED=false

# ========== 日志配置 ==========
LOG_LEVEL=INFO
LOG_FILE=agent.log