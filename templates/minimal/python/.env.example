# ============================================
# 环境变量配置模板
# 复制此文件为 .env 并填入实际值
# ============================================

# LLM API Key (必填)
LLM_API_KEY=your_api_key_here

# LLM Provider (可选: openai, anthropic, local)
LLM_PROVIDER=openai

# Model name (可选)
LLM_MODEL=gpt-4

# 日志级别 (可选: DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO